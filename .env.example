# Application
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Database
DB_URL=jdbc:mysql://localhost:3306/loginmodule?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# JWT
# Must be at least 32 bytes.
JWT_SECRET=change-me-to-at-least-32-bytes-secret
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# OAuth redirect base
# Default: ${APP_FRONTEND_BASE_URL}/oauth/callback
# OAUTH_REDIRECT_BASE_URI=http://localhost:8080/oauth/callback

# Google Developer Console
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
# GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/callback/google

# Kakao Developers
# Use the REST API key as KAKAO_CLIENT_ID, not the JavaScript key.
KAKAO_CLIENT_ID=change-me
# Kakao REST API client secret is optional unless you enabled it in Kakao Developers.
KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=http://localhost:8080/oauth/callback/kakao

# Naver Developers
NAVER_CLIENT_ID=change-me
NAVER_CLIENT_SECRET=change-me
# NAVER_REDIRECT_URI=http://localhost:8080/oauth/callback/naver

# Meta for Developers / Facebook Login
FACEBOOK_CLIENT_ID=change-me
FACEBOOK_CLIENT_SECRET=change-me
FACEBOOK_GRAPH_API_VERSION=v21.0
# FACEBOOK_REDIRECT_URI=http://localhost:8080/oauth/callback/facebook

# GitHub OAuth App
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me
GITHUB_API_VERSION=2026-03-10
# GITHUB_REDIRECT_URI=http://localhost:8080/oauth/callback/github

# Official endpoint overrides are normally unnecessary.
# GOOGLE_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# GOOGLE_USER_INFO_URI=https://openidconnect.googleapis.com/v1/userinfo
# KAKAO_AUTHORIZATION_URI=https://kauth.kakao.com/oauth/authorize
# KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
# KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
# NAVER_AUTHORIZATION_URI=https://nid.naver.com/oauth2.0/authorize
# NAVER_TOKEN_URI=https://nid.naver.com/oauth2.0/token
# NAVER_USER_INFO_URI=https://openapi.naver.com/v1/nid/me
# FACEBOOK_AUTHORIZATION_URI=https://www.facebook.com/${FACEBOOK_GRAPH_API_VERSION}/dialog/oauth
# FACEBOOK_TOKEN_URI=https://graph.facebook.com/${FACEBOOK_GRAPH_API_VERSION}/oauth/access_token
# FACEBOOK_USER_INFO_URI=https://graph.facebook.com/${FACEBOOK_GRAPH_API_VERSION}/me?fields=id,name,email
# GITHUB_AUTHORIZATION_URI=https://github.com/login/oauth/authorize
# GITHUB_TOKEN_URI=https://github.com/login/oauth/access_token
# GITHUB_USER_INFO_URI=https://api.github.com/user
# GITHUB_EMAIL_URI=https://api.github.com/user/emails
